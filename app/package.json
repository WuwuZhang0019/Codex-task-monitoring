{
  "name": "route-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs && npm run test:domain",
    "test:domain": "tsc src/domain.ts --outDir .test-build --module ESNext --target ES2022 --moduleResolution Bundler --skipLibCheck && node --test tests/domain.test.mjs",
    "test:e2e": "npm run build && node tests/e2e.mjs"
  },
  "dependencies": { "react": "^19.0.0", "react-dom": "^19.0.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^4.4.0", "@playwright/test": "^1.51.0", "concurrently": "^9.1.0", "typescript": "^5.7.0", "vite": "^6.1.0" }
}
