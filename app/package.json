{
  "name": "route-workbench",
  "version": "0.2.2",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "build": "node mcp/build-business-schema.mjs",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs mcp/*.test.mjs && npm run test:skill",
    "test:skill": "node --test tests/skill-workflow.test.mjs tests/coordination.test.mjs tests/host-project-preparation.test.mjs tests/host-project-client.test.mjs tests/shared-projects.test.mjs",
    "service": "node desktop/service.mjs",
    "desktop:resources": "node desktop/prepare-resources.mjs",
    "test:desktop": "node --test desktop/*.test.mjs",
    "test:growing:browser": "node tests/growing-routes-browser.mjs",
    "package:exe": "node desktop/package-island.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "esbuild": "0.25.12"
  }
}
