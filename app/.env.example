# Copy to app/.env. Existing environment variables always take precedence.
# Never put a real API key in .env.example or frontend source.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional absolute directory. Default: app/data (projects.json + projects.json.bak).
# One backend process owns this directory. Use a separate directory for tests.
# WORKBENCH_DATA_DIR=G:/rust/Codex-task-monitoring/app/data
# Server always binds 127.0.0.1:4318; Vite may proxy /api from localhost:4317.
