          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "trust": {
          "enum": [
            "declared",
            "userConfirmed",
            "hostObserved"
          ]
        }
      },
      "required": [
        "path",
        "version",
        "sha256",
        "locator",
        "trust"
      ]
