{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "任务航线工作台",
  "version": "0.2.0",
  "identifier": "com.codextaskmonitor.workbench",
  "build": {
    "beforeBuildCommand": "npm run build && npm run desktop:resources",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4317",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "visible": false, "skipTaskbar": true, "title": "任务航线工作台", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 650 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../desktop/resources/": "runtime/" },
    "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }, "nsis": { "installMode": "currentUser" } }
  }
}
