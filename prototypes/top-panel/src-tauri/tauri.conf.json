{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "任务航线演示",
  "version": "0.1.0",
  "identifier": "com.codextaskmonitor.paneldemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "任务航线 · 面板演示",
        "transparent": true,
        "height": 38,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "width": 600,
        "focus": false,
        "label": "main",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true
      },
      {
        "focus": false,
        "skipTaskbar": true,
        "transparent": true,
        "alwaysOnTop": true,
        "height": 522,
        "title": "任务航线 · 展开面板",
        "shadow": false,
        "url": "index.html?view=drawer",
        "label": "drawer",
        "decorations": false,
        "visible": false,
        "resizable": false,
        "width": 920
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
